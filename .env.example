# Neno 的配置。复制成 .env 再改（python run.py 第一次运行会自动做这一步）。
# 真实的密钥只放在本机 .env 里，不要提交。

# ── 必填：一个模型密钥 ─────────────────────────────────────────────
# https://openrouter.ai/keys 建一个，sk-or- 开头。run.py 没找到会问你要。
OPENROUTER_API_KEY=
OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions
# 访问 OpenRouter 要走代理的话：
# OPENROUTER_PROXY=http://127.0.0.1:7890

# ── 模型：省钱档（默认）────────────────────────────────────────────
# 正常聊天一天大约几毛到一块钱人民币。
OPENROUTER_CHAT_MODEL=anthropic/claude-haiku-5.5
MIND_L1_MODEL=anthropic/claude-haiku-5.5
MIND_EXPR_MODEL=anthropic/claude-haiku-5.5
OPENROUTER_VISION_MODEL=anthropic/claude-haiku-5.5
WORLD_NPC_MODEL=deepseek/deepseek-v4.1-flash
CONTEXT_SUMMARY_MODEL=openai/gpt-6-luna
IMAGE_ARCHIVE_MODEL=openai/gpt-6-luna
# 质量档（作者自己在用，贵二十倍左右，说话明显更像人）：
# OPENROUTER_CHAT_MODEL=anthropic/claude-opus-5.5     ← 深思，最花钱的一步
# MIND_EXPR_MODEL=google/gemini-4-carbon              ← 措辞
# 只想让"深思"用好模型：MIND_THINK_MODEL=anthropic/claude-sonnet-5.5

# ── 在哪跟她说话 ───────────────────────────────────────────────────
# 什么都不填：就在运行 run.py 的终端里聊。
# Telegram 机器人：去 @BotFather 发 /newbot 拿 token 填在这里，重新运行 run.py，按提示发配对码。
TELEGRAM_BOT_TOKEN=
# 在国内连 Telegram 要代理：
# TELEGRAM_BOT_PROXY=http://127.0.0.1:7890

# ── 她会不会主动找你 ───────────────────────────────────────────────
# on 会 / shadow 只在心里记着不发（python -m app.services.mind.proactive 能看到她本来想说什么）/ off 不会
MIND_PROACTIVE=on

# ── 一般不用动 ─────────────────────────────────────────────────────
MIND_ENABLED=true
MIND_ASYNC_DELIVERY=true
CHAT_PERSONA_ENABLED=false
MIND_HOME_SESSION=me
MIND_TIMEZONE=Asia/Shanghai
MIND_WORLD_ID=neno-life
MIND_WORLD_DECISIONS=true
MIND_WORLD_DECISIONS_PER_DAY=6
WORLD_ENABLED=true
WORLD_RULE_SCHEDULER_ENABLED=true
WORLD_NPC_ENABLED=true
WORLD_NPC_MAX_CALLS_PER_DAY=40
CONTEXT_SUMMARY_ENABLED=true
CHAT_MAX_TOKENS=2000
LLM_TIMEOUT_SECONDS=180
HISTORY_TOKEN_LIMIT=10000
SESSION_AGGREGATION_WINDOW_SECONDS=3
# 后端和通道之间的暗号、管理接口的口令：留空，run.py 会自动生成。
NENO_INTERNAL_TOKEN=
ADMIN_TOKEN=
# 换端口：NENO_PORT=8000

# ── 可以关掉的 ─────────────────────────────────────────────────────
# 世界里的天气、电影、展览跟现实同步（杭州）；她刷手机时真的上网看东西。都要联网，不想要就设 false。
# WORLD_REAL_WEATHER=false
# WORLD_REAL_FEED=false
# WORLD_SURF_ENABLED=false

# ── 进阶：用真人号的 Telegram（TDLib，要编译，见 docs/telegram-user-account.md）──
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# TELEGRAM_DATABASE_ENCRYPTION_KEY=
# TELEGRAM_ALLOWED_CHAT_IDS=
# TDLIB_JSON_LIBRARY=
# TDLIB_SIDECAR_BINARY=
# NENO_MIND_ASYNC=true
# 这时把 MIND_HOME_SESSION 改成 tg:<你的 chat id>

# 其余可调的参数（节奏、记忆、反思……）都有默认值，见 app/config.py。
