# Neno Core + Telegram TDLib Gateway
OPENROUTER_API_KEY=replace-with-your-openrouter-key
OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_PROXY=
OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
OPENROUTER_VISION_MODEL=openai/gpt-4o-mini
IMAGE_ARCHIVE_MODEL=openai/gpt-6-luna
IMAGE_ARCHIVE_EXTRA_BODY={"reasoning":{"effort":"none"}}
CHAT_MAX_TOKENS=220
LLM_TIMEOUT_SECONDS=60
HISTORY_TOKEN_LIMIT=500
SESSION_AGGREGATION_WINDOW_SECONDS=3
ADMIN_TOKEN=replace-with-admin-token
CORS_ALLOWED_ORIGINS=

# Telegram user client (TDLib; not a Bot Token)
TELEGRAM_API_ID=replace-with-telegram-api-id
TELEGRAM_API_HASH=replace-with-telegram-api-hash
TELEGRAM_DATABASE_ENCRYPTION_KEY=replace-with-random-local-key
TELEGRAM_ALLOWED_CHAT_IDS=
TDLIB_JSON_LIBRARY=runtime/tdlib/tdjson.dll
TDLIB_SIDECAR_BINARY=telegram_sidecar/build/Release/neno-tdlib-sidecar.exe
NENO_CORE_URL=http://127.0.0.1:8000
NENO_INTERNAL_TOKEN=replace-with-a-separate-random-internal-token
NENO_IMAGE_SPOOL_ROOTS=
TELEGRAM_MAX_MEDIA_MB=200
TELEGRAM_DOWNLOAD_TIMEOUT_SECONDS=180

# Independent world cognition; WORLD_ENABLED and per-world cognition remain opt-in.
# Blank URL/key reuse OPENROUTER_URL/API_KEY; chat model settings are not inherited.
WORLD_RULE_SCHEDULER_ENABLED=false
WORLD_COGNITION_AUTOSTART=false
WORLD_LLM_ENABLED=false
WORLD_LLM_MODEL=openai/gpt-6-luna
WORLD_LLM_EXTRA_BODY={"reasoning":{"effort":"none"}}
WORLD_LLM_URL=
WORLD_LLM_API_KEY=
WORLD_LLM_MAX_CALLS_PER_DAY=48
WORLD_LLM_MIN_CALL_INTERVAL_SECONDS=60
WORLD_LLM_TIMEOUT_SECONDS=45
WORLD_LLM_MAX_OUTPUT_TOKENS=1200
WORLD_LLM_MAX_CONTEXT_CHARS=14000
CONTEXT_SUMMARY_ENABLED=true
CONTEXT_SUMMARY_MODEL=openai/gpt-6-luna
NENO_BACKUP_DIRECTORY=E:/NenoBackups
NENO_BACKUP_RETENTION=7
