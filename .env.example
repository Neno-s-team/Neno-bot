# Neno Core + Telegram TDLib Gateway
OPENROUTER_API_KEY=replace-with-your-openrouter-key
OPENROUTER_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_PROXY=
OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
OPENROUTER_VISION_MODEL=openai/gpt-4o-mini
IMAGE_ARCHIVE_MODEL=openai/gpt-6-luna
IMAGE_ARCHIVE_EXTRA_BODY={"reasoning":{"effort":"none"}}
CHAT_MAX_TOKENS=220
LLM_TIMEOUT_SECONDS=60
HISTORY_TOKEN_LIMIT=500
SESSION_AGGREGATION_WINDOW_SECONDS=3
ADMIN_TOKEN=replace-with-admin-token
CORS_ALLOWED_ORIGINS=

# Telegram user client (TDLib; not a Bot Token)
TELEGRAM_API_ID=replace-with-telegram-api-id
TELEGRAM_API_HASH=replace-with-telegram-api-hash
TELEGRAM_DATABASE_ENCRYPTION_KEY=replace-with-random-local-key
TELEGRAM_ALLOWED_CHAT_IDS=
TDLIB_JSON_LIBRARY=runtime/tdlib/tdjson.dll
TDLIB_SIDECAR_BINARY=telegram_sidecar/build/Release/neno-tdlib-sidecar.exe
NENO_CORE_URL=http://127.0.0.1:8000
NENO_INTERNAL_TOKEN=replace-with-a-separate-random-internal-token
NENO_IMAGE_SPOOL_ROOTS=
TELEGRAM_MAX_MEDIA_MB=200
TELEGRAM_DOWNLOAD_TIMEOUT_SECONDS=180

# Independent world cognition; WORLD_ENABLED and per-world cognition remain opt-in.
# Blank URL/key reuse OPENROUTER_URL/API_KEY; chat model settings are not inherited.
WORLD_RULE_SCHEDULER_ENABLED=false
WORLD_COGNITION_AUTOSTART=false
WORLD_LLM_ENABLED=false
WORLD_LLM_MODEL=openai/gpt-6-luna
WORLD_LLM_EXTRA_BODY={"reasoning":{"effort":"none"}}
WORLD_LLM_URL=
WORLD_LLM_API_KEY=
WORLD_LLM_MAX_CALLS_PER_DAY=48
WORLD_LLM_MIN_CALL_INTERVAL_SECONDS=60
WORLD_LLM_TIMEOUT_SECONDS=45
WORLD_LLM_MAX_OUTPUT_TOKENS=1200
WORLD_LLM_MAX_CONTEXT_CHARS=14000
CONTEXT_SUMMARY_ENABLED=true
CONTEXT_SUMMARY_MODEL=openai/gpt-6-luna
NENO_BACKUP_DIRECTORY=E:/NenoBackups
NENO_BACKUP_RETENTION=7

# ── 多层大脑 P1（骨架，默认关闭） ─────────────────────────────────────────────
# 开启后 chat turn 走 L1 直觉 + E1 规划 + E2 措辞 + E3 渲染的完整认知周期；
# 关闭时与原有单轮对话行为完全一致。
MIND_ENABLED=false
# L1 廉价模型，必须支持 response_format.json_schema；不支持时明确报错，不静默降级。
MIND_L1_MODEL=openai/gpt-4o-mini
MIND_L1_EXTRA_BODY={"reasoning":{"effort":"none"}}
# E2 默认复用聊天主模型，不开思考。
MIND_EXPR_MODEL=
MIND_EXPR_EXTRA_BODY={"reasoning":{"effort":"none"}}
# 人设卡（占位版本，P2 后由人设系统维护）
MIND_SELF_CARD_PATH=prompts/mind/self_card.md
MIND_STYLE_CARD_PATH=prompts/mind/style_card.md
# E2 能看到的最近原话条数
MIND_RECENT_TURNS=6
# 情绪半衰期（分钟）
MIND_AFFECT_HALF_LIFE_MINUTES=180
# 深夜时段（23:00-05:00）时区
MIND_TIMEZONE=Asia/Shanghai
# E3 拆条上限
MIND_E3_MAX_MESSAGES=4
# E3 单条消息超过该长度时在标点处切开
MIND_E3_MAX_SINGLE_CHARS=200

# ── 多层大脑 P2（默认随 MIND_ENABLED 一起生效） ───────────────────────────────
# L2 深思模型；留空 = 复用 OPENROUTER_CHAT_MODEL。开思考，结构化输出。
MIND_THINK_MODEL=
MIND_THINK_EXTRA_BODY={"reasoning":{"effort":"medium"}}
MIND_THINK_MAX_TOKENS=8000
# L1 判定 depth=fast 时跳过 L2
MIND_FAST_SKIP_L2=true
# 工作记忆预算（字符）与槽位条数
MIND_WM_MAX_CHARS=6000
MIND_WM_EPISODES=5
MIND_WM_BELIEFS=5
# 记忆衰减半衰期（天）
MIND_RECENCY_HALF_LIFE_DAYS=7
MIND_MEMORY_HALF_LIFE_DAYS=14
# 检索权重：rel 相关 / rec 新近 / imp 重要 / emo 情绪 / str 记忆强度
MIND_RETRIEVAL_WEIGHTS={"rel":1,"rec":1,"imp":1,"emo":1,"str":1}
# 记忆范围；本阶段只实现 session
MIND_MEMORY_SCOPE=session
# 认识首次写入的可信度上限（min(模型值, 该值)）
MIND_BELIEF_INIT_MAX=0.6

# ── 多层大脑 P3a（L0 感知/课表/待想队列/投递/调度器） ────────────────────────
# false 时 /chat 行为与 P2 完全一致，L0 不参与
MIND_ASYNC_DELIVERY=false
MIND_SCHEDULE_PATH=prompts/mind/schedule.json
# 各打断等级的看手机强度 λ（次/分钟）
MIND_L0_LAMBDA_PER_MIN={"0":0,"1":0.025,"2":0.12,"3":0.35,"4":3.0}
# 预览只截前 N 字
MIND_PREVIEW_CHARS=30
# 预览 urgency 超过该值 → 抢占
MIND_PREEMPT_URGENCY=0.8
# 她最近 N 分钟发过消息且等级>=3 → 视为等级 4
MIND_FOCUS_WINDOW_MIN=5
# 打字速度（字/秒），乘 0.8-1.2 抖动，单条时长截到 [1,15]
MIND_TYPING_CPS=5
# 同一轮多条消息之间的间隔范围（秒）
MIND_MSG_GAP_SEC=[1,4]
# hesitate：先 typing 3 秒，停 N 秒再发
MIND_HESITATE_PAUSE_SEC=[5,20]
MIND_SCHEDULER_TICK_SEC=2
MIND_LEASE_SEC=120
